diff --git a/kernel/proc.c b/kernel/proc.c
index 31f23a3..7b41282 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -5,6 +5,7 @@
 #include "spinlock.h"
 #include "proc.h"
 #include "defs.h"
+#include "pstat.h"
 
 struct cpu cpus[NCPU];
 
@@ -89,6 +90,88 @@ myproc(void)
   return p;
 }
 
+void
+proc_tick(void)
+{
+  struct proc *p = myproc();
+
+  if (p) {
+    acquire(&p->lock);
+    if (p->state == RUNNING)
+      p->rtime++;
+    release(&p->lock);
+  }
+}
+
+
+int
+procinfo(uint64 addr)
+{
+  struct proc *p;
+  struct proc *curproc = myproc();
+  struct pinfo *snapshot;
+  int count = 0;
+  uint now;
+
+  snapshot = (struct pinfo *)kalloc();
+  if (snapshot == 0)
+    return -1;
+
+  acquire(&tickslock);
+  now = ticks;
+  release(&tickslock);
+
+  acquire(&wait_lock);
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+
+    if (p->state != UNUSED) {
+      snapshot[count].pid = p->pid;
+      snapshot[count].ppid = p->parent ? p->parent->pid : 0;
+      snapshot[count].state = p->state;
+      snapshot[count].ticks = p->rtime;
+      snapshot[count].nsched = p->nsched;
+      snapshot[count].ctime = p->ctime;
+      snapshot[count].sz = p->sz;
+      safestrcpy(snapshot[count].name, p->name, sizeof(snapshot[count].name));
+
+      count++;
+    }
+
+    release(&p->lock);
+  }
+
+  release(&wait_lock);
+
+  for (int i = 0; i < count; i++) {
+    uint64 dst = addr + sizeof(int) + sizeof(uint) + i * sizeof(struct pinfo);
+
+    if (copyout(curproc->pagetable, curproc->sz, dst, (char *)&snapshot[i],
+                sizeof(struct pinfo)) < 0) {
+      kfree((char *)snapshot);
+      return -1;
+    }
+  }
+
+  struct {
+    int count;
+    uint now;
+  } header;
+
+  header.count = count;
+  header.now = now;
+
+  if (copyout(curproc->pagetable, curproc->sz, addr, (char *)&header,
+              sizeof(header)) < 0) {
+    kfree((char *)snapshot);
+    return -1;
+  }
+
+  kfree((char *)snapshot);
+  return 0;
+}
+
