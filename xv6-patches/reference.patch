diff --git a/kernel/pstat.h b/kernel/pstat.h
new file mode 100644
index 0000000..b4bb789
--- /dev/null
+++ b/kernel/pstat.h
@@ -0,0 +1,25 @@
+#include "types.h"
+
+#ifndef _PSTAT_H_
+#define _PSTAT_H_
+
+#define PSTAT_MAX 64
+
+struct pinfo {
+  int pid;
+  int ppid;
+  int state;
+  uint ticks;
+  uint nsched;
+  uint ctime;
+  uint64 sz;
+  char name[16];
+};
+
+struct pstat {
+  int count;
+  uint now;
+  struct pinfo procs[PSTAT_MAX];
+};
+
+#endif
